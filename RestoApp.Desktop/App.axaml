<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestoApp.Desktop.ViewModels"
             xmlns:v="using:RestoApp.Desktop.Views"
             x:Class="RestoApp.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <!-- Mapeo automático de ViewModel a Vista -->
        <DataTemplate DataType="{x:Type vm:MesasViewModel}">
            <v:MesasView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReservasViewModel}">
            <v:ReservasView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>
</Application>