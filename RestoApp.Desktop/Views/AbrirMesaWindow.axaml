<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestoApp.Desktop.ViewModels"
        x:Class="RestoApp.Desktop.Views.AbrirMesaWindow"
        x:DataType="vm:AbrirMesaViewModel"
        Title="RestoApp - Apertura de Mesa de Salón"
        Height="690" Width="1040"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#F8F9FA">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="16">

        <!-- ========================================== -->
        <!-- FILA 0: ENCABEZADO CON FECHA Y HORA EN VIVO -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
            <!-- Título y Reloj en Vivo -->
            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🍽️" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Abrir Mesa de Salón" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Fecha y Hora en Vivo (Sin emoji de calendario, fecha más grande) -->
                <Border Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FechaActualTexto}" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                        <TextBlock Text="•" FontSize="16" Foreground="#93C5FD" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="⏰" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HoraActualTexto}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Badges Resumen de Estado -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="#2ECC71" CornerRadius="6" Padding="12,6">
                    <TextBlock Text="{Binding LibresCount, StringFormat='Libres: {0}'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <Border Background="#F39C12" CornerRadius="6" Padding="12,6">
                    <TextBlock Text="{Binding OcupadasCount, StringFormat='Ocupadas: {0}'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <Border Background="#3498DB" CornerRadius="6" Padding="12,6">
                    <TextBlock Text="{Binding ReservadasCount, StringFormat='Reservadas: {0}'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ========================================== -->
        <!-- FILA 1: FILTRO POR UBICACIÓN               -->
        <!-- ========================================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="Ubicación:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,12,0"/>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Ubicaciones}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                    Command="{Binding $parent[Window].((vm:AbrirMesaViewModel)DataContext).FiltrarPorUbicacionCommand}" 
                                    CommandParameter="{Binding}"
                                    Background="#F1F5F9" Foreground="#334155" 
                                    BorderBrush="#CBD5E1" BorderThickness="1" 
                                    CornerRadius="6" Padding="12,5" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- FILA 2: GRILLA VISUAL DE TARJETAS DE MESA -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MesasFiltradas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VisualMesaItemViewModel">
                            <Button Command="{Binding $parent[Window].((vm:AbrirMesaViewModel)DataContext).SeleccionarMesaCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="4"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                
                                <Border Background="{Binding EstadoLightBackground}" 
                                        BorderBrush="{Binding CurrentBorderBrush}" 
                                        BorderThickness="{Binding CurrentBorderThickness}" 
                                        CornerRadius="8" 
                                        ClipToBounds="True" Height="125">

                                    <Grid RowDefinitions="Auto, *">
                                        <!-- Header de Estado con Color de Inicio -->
                                        <Border Grid.Row="0" Background="{Binding EstadoHeaderBackground}" Padding="6,4">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding BannerText}" Foreground="White" 
                                                           FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="✓" Foreground="White" FontWeight="Bold" FontSize="12"
                                                           IsVisible="{Binding IsSelected}" Margin="0,0,2,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Cuerpo de la Tarjeta Cuadrada -->
                                        <Border Grid.Row="1" Padding="8,6">
                                            <Grid RowDefinitions="Auto, Auto, *">
                                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding NroMesa, StringFormat='Mesa #{0}'}" 
                                                               FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="👤" FontSize="11" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding Capacidad}" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Grid.Row="1" Text="{Binding UbicacionDescripcion}" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"/>

                                                <!-- Indicador de selección -->
                                                <Border Grid.Row="2" Background="#2563EB" CornerRadius="4" Padding="4,2" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,4,0,0"
                                                        IsVisible="{Binding IsSelected}">
                                                    <TextBlock Text="SELECCIONADA" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ========================================== -->
        <!-- FILA 3: PANEL INFERIOR Y ACCIÓN DE APERTURA -->
        <!-- ========================================== -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
            <StackPanel Spacing="10">
                <!-- Banner de Error si aplica -->
                <Border Background="#FDEDEC" BorderBrush="#F5B7B1" BorderThickness="1" CornerRadius="6" Padding="10,6"
                        IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="16" VerticalAlignment="Center">
                    <!-- Mesa Seleccionada -->
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Mesa Elegida:" FontSize="11" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding MesaSeleccionada.NroMesa, StringFormat='Mesa #{0}', FallbackValue='Ninguna seleccionada'}" 
                                   FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                    </StackPanel>

                    <!-- Selector de Mozo a Cargo -->
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Mozo:" FontSize="11" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                        <ComboBox ItemsSource="{Binding Mozos}"
                                  SelectedItem="{Binding MozoSeleccionado}"
                                  DisplayMemberBinding="{Binding NombreCompleto}"
                                  Width="260" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Botones de Acción -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Cancelar" Click="BtnCancelar_Click" 
                                Background="#95A5A6" Foreground="White" 
                                Padding="18,10" CornerRadius="6" Cursor="Hand" FontWeight="SemiBold"/>

                        <Button Click="BtnAbrirMesa_Click" 
                                Background="#27AE60" Foreground="White" 
                                Padding="22,10" CornerRadius="6" Cursor="Hand" FontWeight="Bold" FontSize="14">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="🍽️" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Abrir Mesa" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>

