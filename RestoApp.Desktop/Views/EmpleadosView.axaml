<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestoApp.Desktop.ViewModels"
             x:Class="RestoApp.Desktop.Views.EmpleadosView"
             x:DataType="vm:EmpleadosViewModel">

    <Grid RowDefinitions="Auto, *">
        
        <!-- ========================================== -->
        <!-- ENCABEZADO DE SECCIÓN Y ACCIONES PRINCIPALES -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="👥 Gestión de Personal y Empleados" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
                <TextBlock Text="Administración de nómina, roles del sistema, accesos y contacto de la plantilla" FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Command="{Binding VerBajasCommand}" 
                        Background="#34495E" Foreground="White" 
                        Padding="14,9" CornerRadius="6" Cursor="Hand" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📁" FontSize="13"/>
                        <TextBlock Text="Personal Inactivo"/>
                    </StackPanel>
                </Button>

                <Button IsVisible="{Binding PuedeAgregar}" 
                        Click="BtnNuevoEmpleado_Click" 
                        Background="#27AE60" Foreground="White" 
                        Padding="16,9" CornerRadius="6" Cursor="Hand" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="👤+" FontSize="13"/>
                        <TextBlock Text="Nuevo Empleado"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========================================== -->
        <!-- CONTENIDO DINÁMICO (VISTA PRINCIPAL / BAJAS) -->
        <!-- ========================================== -->
        <Panel Grid.Row="1">
            
            <!-- VISTA PRINCIPAL -->
            <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding EsVistaPrincipal}">
                
                <!-- 1. TARJETAS KPI RESUMIDAS -->
                <Grid Grid.Row="0" ColumnDefinitions="*, *, *, *" Margin="0,0,0,15">
                    
                    <!-- KPI 1: Plantilla Total -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Background="#EBF5FB" CornerRadius="8" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Plantilla Total" FontSize="11" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalEmpleadosCount}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Activos -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Background="#E8F8F5" CornerRadius="8" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="🟢" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Personal Activo" FontSize="11" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ActivosCount}" FontSize="20" FontWeight="Bold" Foreground="#27AE60"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Mozos en Servicio -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Background="#FEF9E7" CornerRadius="8" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="👨‍🍳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Equipo Mozos" FontSize="11" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MozosCount}" FontSize="20" FontWeight="Bold" Foreground="#D68910"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 4: Inactivos -->
                    <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Background="#FDEDEC" CornerRadius="8" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="⛔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Bajas / Inactivos" FontSize="11" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InactivosCount}" FontSize="20" FontWeight="Bold" Foreground="#E74C3C"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

                <!-- 2. BARRA DE BÚSQUEDA Y FILTRADO POR ROL -->
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                    
                    <!-- Caja de Búsqueda -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, Mode=TwoWay}" 
                                     PlaceholderText="Buscar por nombre, DNI, rol o teléfono..." 
                                     BorderThickness="0" Background="Transparent" 
                                     VerticalContentAlignment="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Filtro Selector de Rol -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Filtrar Cargo:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,4,0"/>
                        <ComboBox SelectedItem="{Binding FiltroRol, Mode=TwoWay}" Height="36" Width="140" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Dueño"/>
                            <ComboBoxItem Content="Gerente"/>
                            <ComboBoxItem Content="Cajero"/>
                            <ComboBoxItem Content="Mozo"/>
                            <ComboBoxItem Content="Recepcion"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 3. TABLA DE DATOS PRINCIPAL -->
                <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Padding="15">
                    <DataGrid ItemsSource="{Binding EmpleadosFiltrados}" 
                              AutoGenerateColumns="False" IsReadOnly="True" 
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                              BorderThickness="1" BorderBrush="#E0E6ED" CornerRadius="6">
                        <DataGrid.Columns>
                            
                            <!-- DNI -->
                            <DataGridTemplateColumn Header="DNI Documento" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="🪪" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DniEmpleado}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Nombre Completo con Avatar -->
                            <DataGridTemplateColumn Header="Nombre y Apellido" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0">
                                            <Border Background="#F2F4F4" CornerRadius="14" Width="28" Height="28" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AvatarIcon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding NombreCompleto}" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cargo / Rol Badge -->
                            <DataGridTemplateColumn Header="Cargo / Rol" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                                        <Border Background="{Binding RolBadgeBackground}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding RolCargo}" Foreground="{Binding RolBadgeForeground}" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Teléfono -->
                            <DataGridTemplateColumn Header="Teléfono" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="📞" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Telefono}" Foreground="#34495E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Estado Badge -->
                            <DataGridTemplateColumn Header="Estado" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                                        <Border Background="{Binding EstadoBadgeBackground}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding Estado}" Foreground="{Binding EstadoBadgeForeground}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones -->
                            <DataGridTemplateColumn Header="Acciones" Width="Auto" 
                                                    IsVisible="{Binding $parent[UserControl].((vm:EmpleadosViewModel)DataContext).PuedeEditar}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="10,0">
                                            <Button Click="BtnEditar_Click" 
                                                    Background="#FEF9E7" Foreground="#F39C12" 
                                                    BorderBrush="#F39C12" BorderThickness="1" 
                                                    CornerRadius="5" Padding="8,4" Cursor="Hand" ToolTip.Tip="Editar datos del empleado">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="✏️" FontSize="11"/>
                                                    <TextBlock Text="Editar" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Click="BtnEliminar_Click" 
                                                    Background="#FDEDEC" Foreground="#E74C3C" 
                                                    BorderBrush="#E74C3C" BorderThickness="1" 
                                                    CornerRadius="5" Padding="8,4" Cursor="Hand" ToolTip.Tip="Dar de baja empleado">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🚫" FontSize="11"/>
                                                    <TextBlock Text="Baja" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- VISTA BAJAS / ARCHIVO DE PERSONAL INACTIVO -->
            <Grid RowDefinitions="Auto, *" IsVisible="{Binding EsVistaBajas}">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📁 Personal Inactivo (Histórico de Bajas)" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Registro de exempleados dados de baja con opción de restitución" FontSize="12" Foreground="#7F8C8D"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="⬅️ Volver a Personal" Command="{Binding VolverPrincipalCommand}" Background="#34495E" Foreground="White" Padding="14,8" CornerRadius="6" Cursor="Hand" FontWeight="Bold"/>
                </Grid>

                <Border Grid.Row="1" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Padding="15">
                    <DataGrid ItemsSource="{Binding EmpleadosBajas}" 
                              AutoGenerateColumns="False" IsReadOnly="True" 
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                              BorderThickness="1" BorderBrush="#E0E6ED" CornerRadius="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI" Binding="{Binding DniEmpleado}" Width="1.2*"/>
                            <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="2*"/>
                            <DataGridTextColumn Header="Cargo" Binding="{Binding RolCargo}" Width="1.5*"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="1.5*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                            
                            <DataGridTemplateColumn Header="Acciones" Width="Auto" IsVisible="{Binding $parent[UserControl].((vm:EmpleadosViewModel)DataContext).PuedeEditar}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                                        <Button Command="{Binding $parent[UserControl].((vm:EmpleadosViewModel)DataContext).RestaurarEmpleadoCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#E8F8F5" Foreground="#27AE60" 
                                                BorderBrush="#27AE60" BorderThickness="1" 
                                                CornerRadius="5" Padding="10,5" Cursor="Hand" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="🔄" FontSize="11"/>
                                                <TextBlock Text="Restaurar (Re-activar)" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

        </Panel>
    </Grid>
</UserControl>