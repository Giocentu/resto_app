<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestoApp.Desktop.ViewModels"
             x:Class="RestoApp.Desktop.Views.EmpleadosView"
             x:DataType="vm:EmpleadosViewModel">

    <Grid RowDefinitions="Auto, *" Margin="10">
        <!-- Encabezado -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" Text="Gestión de Personal" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            
            <!-- El botón de agregar empleado solo lo ve el Admin -->
            <Button Grid.Column="1" Content="+ Nuevo Empleado" 
                    Background="#27AE60" Foreground="White" Padding="15,8" CornerRadius="5" Cursor="Hand"
                    IsVisible="{Binding $parent[UserControl].((vm:EmpleadosViewModel)DataContext).PuedeAgregar}"/>
        </Grid>

        <!-- Tabla -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Empleados}" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  GridLinesVisibility="All" BorderBrush="LightGray" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="2*"/>
                <DataGridTextColumn Header="Cargo" Binding="{Binding RolCargo}" Width="1.5*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="1.5*"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                
                <!-- Acciones (Ocultas si no tiene permisos) -->
                <DataGridTemplateColumn Header="Acciones" Width="Auto" 
                                        IsVisible="{Binding $parent[UserControl].((vm:EmpleadosViewModel)DataContext).PuedeEditar}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:EmpleadoItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Editar" Background="Transparent" Foreground="#F39C12" Cursor="Hand"/>
                                <Button Content="Baja" Background="Transparent" Foreground="#E74C3C" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>