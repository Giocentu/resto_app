<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestoApp.Desktop.ViewModels"
             x:Class="RestoApp.Desktop.Views.MenuView"
             x:DataType="vm:MenuViewModel">

    <UserControl.Styles>
        <Style Selector="Border.menuCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="BoxShadow" Value="0 2 6 0 #0D000000"/>
        </Style>

        <!-- Estilos para los botones del selector de 3 vistas -->
        <Style Selector="Button.filtroBtn">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.filtroBtn.activeFilter">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- ========================================== -->
        <!-- CONTENIDO PRINCIPAL                        -->
        <!-- ========================================== -->
        <Grid RowDefinitions="Auto, Auto, Auto, *">

            <!-- FILA 0: ENCABEZADO -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Menu" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="Catálogo de platos, bebidas, precios y disponibilidad en salón" FontSize="12" Foreground="#7F8C8D"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="Nuevo Item" 
                        Command="{Binding AbrirNuevoItemCommand}"
                        IsVisible="{Binding PuedeGestionar}"
                        Background="#27AE60" Foreground="White" 
                        FontWeight="Bold" Padding="16,8" CornerRadius="8" Cursor="Hand"/>
            </Grid>

            <!-- FILA 1: BARRA DE FILTROS -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                    <!-- Buscador acotado -->
                    <TextBox Grid.Column="0" 
                             Text="{Binding FiltroTexto, Mode=TwoWay}"
                             PlaceholderText="Buscar plato o bebida..." 
                             Width="260" Height="38" Margin="0,0,12,0" 
                             VerticalContentAlignment="Center"/>

                    <!-- Selector de Categoría -->
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding CategoriaSeleccionada, Mode=TwoWay}"
                              Width="200" Height="38" Margin="0,0,12,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Selector de 3 Vistas: Activos / Desactivados / Todos (Opción C) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" 
                                IsVisible="{Binding PuedeGestionar}" VerticalAlignment="Center">
                        <TextBlock Text="Estado:" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <Button Content="Activos" 
                                Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Activos"
                                Classes="filtroBtn" Classes.activeFilter="{Binding EsFiltroActivos}"/>

                        <Button Content="Desactivados" 
                                Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Desactivados"
                                Classes="filtroBtn" Classes.activeFilter="{Binding EsFiltroDesactivados}"/>

                        <Button Content="Todos" 
                                Command="{Binding CambiarFiltroEstadoCommand}" CommandParameter="Todos"
                                Classes="filtroBtn" Classes.activeFilter="{Binding EsFiltroTodos}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FILA 2: BANNER INFORMATIVO (CUANDO NO HAY DESACTIVADOS) -->
            <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.5" 
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,15"
                    IsVisible="{Binding MostrarMensajeInformativo}">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Aviso:" FontWeight="Bold" Foreground="#B45309" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MensajeInformativo}" 
                                   Foreground="#92400E" FontWeight="SemiBold" FontSize="13" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" 
                            Command="{Binding CerrarMensajeInformativoCommand}"
                            Background="Transparent" Foreground="#B45309" FontWeight="Bold"
                            FontSize="13" Padding="8,2" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- FILA 3: LISTADO DE PRODUCTOS / TARJETAS -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ItemsFiltrados}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MenuItemViewModel">
                            <Border Classes="menuCard">
                                <Grid RowDefinitions="Auto, *, Auto">
                                    
                                    <!-- Categoría con color distintivo y Estado -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                        <Border Grid.Column="0" Background="{Binding ColorFondoCategoria}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CategoriaNombre}" Foreground="{Binding ColorTextoCategoria}" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <Border Grid.Column="1" Background="{Binding ColorBadgeEstado}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{Binding EstadoTexto}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Descripción del Producto -->
                                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,4,0,10">
                                        <TextBlock Text="{Binding Descripcion}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PrecioFormateado}" FontSize="18" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <!-- Botones de Acción (Admin) -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,6,0,0"
                                          IsVisible="{Binding $parent[UserControl].((vm:MenuViewModel)DataContext).PuedeGestionar}">
                                        
                                        <Button Grid.Column="0" Content="Editar" 
                                                Command="{Binding $parent[UserControl].((vm:MenuViewModel)DataContext).AbrirEditarItemCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#F1F5F9" Foreground="#334155" FontSize="12"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Margin="0,0,4,0" CornerRadius="6" Cursor="Hand"/>

                                        <Button Grid.Column="1" 
                                                Content="{Binding TextoBotonEstado}"
                                                Command="{Binding $parent[UserControl].((vm:MenuViewModel)DataContext).ToggleEstadoItemCommand}"
                                                CommandParameter="{Binding}"
                                                Background="{Binding ColorFondoBotonEstado}" 
                                                Foreground="{Binding ColorTextoBotonEstado}" 
                                                FontSize="12" FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Margin="4,0,0,0" CornerRadius="6" Cursor="Hand"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ========================================== -->
        <!-- MODAL OVERLAY: CREAR / EDITAR ITEM         -->
        <!-- ========================================== -->
        <Border Background="#80000000" IsVisible="{Binding MostrarModalEditor}" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" Width="440" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 25 0 #40000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding TituloEditor}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                    <Separator Background="#E2E8F0" Margin="0,0,0,6"/>

                    <!-- Mensaje de Error si hay -->
                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10" 
                            IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding MensajeError}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Descripción -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Descripcion / Nombre:" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                        <TextBox Text="{Binding EditorDescripcion, Mode=TwoWay}" PlaceholderText="Ej. Bife de Chorizo 400g" Height="38"/>
                    </StackPanel>

                    <!-- Categoría -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Categoria:" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                        <ComboBox ItemsSource="{Binding Categorias}"
                                  SelectedItem="{Binding EditorCategoriaSeleccionada, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" Height="38">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Precio -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Precio ($):" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                        <TextBox Text="{Binding EditorPrecio, Mode=TwoWay}" PlaceholderText="Ej. 12500" Height="38"/>
                    </StackPanel>

                    <!-- Activo Check -->
                    <CheckBox IsChecked="{Binding EditorActivo, Mode=TwoWay}" Content="Disponible para comanda" Margin="0,4,0,0"/>

                    <!-- Botones de Acción -->
                    <Grid ColumnDefinitions="*, *" Margin="0,12,0,0">
                        <Button Grid.Column="0" Content="Cancelar" 
                                Command="{Binding CerrarModalCommand}"
                                Background="#E2E8F0" Foreground="#475569" 
                                Height="40" Margin="0,0,6,0" CornerRadius="8"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                        <Button Grid.Column="1" Content="Guardar" 
                                Command="{Binding GuardarItemCommand}"
                                Background="#27AE60" Foreground="White" FontWeight="Bold"
                                Height="40" Margin="6,0,0,0" CornerRadius="8"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
