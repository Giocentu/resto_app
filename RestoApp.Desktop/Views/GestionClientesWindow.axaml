<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestoApp.Desktop.ViewModels"
        x:Class="RestoApp.Desktop.Views.GestionClientesWindow"
        Title="RestoApp - Gestión de Clientes"
        Height="620" Width="1050"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#F8F9FA">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        
        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitulo" Text="Gestión de Clientes" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtSubtitulo" Text="Búsqueda, modificación y alta de clientes activos del restaurante" FontSize="12" Foreground="#7F8C8D" Margin="34,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BtnToggleBajas" Click="BtnToggleBajas_Click" 
                        Background="#34495E" Foreground="White" 
                        Padding="14,9" CornerRadius="6" Cursor="Hand" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="IconToggleBajas" Text="📁" FontSize="13"/>
                        <TextBlock x:Name="TxtToggleBajas" Text="Inactivos"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnNuevoCliente" Click="BtnNuevoCliente_Click" 
                        Background="#27AE60" Foreground="White" 
                        Padding="16,9" CornerRadius="6" Cursor="Hand" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="➕" FontSize="13"/>
                        <TextBlock Text="Nuevo Cliente"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- TOOLBAR BÚSQUEDA Y MENSAJE -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox x:Name="TxtBusqueda" PlaceholderText="🔍 Buscar por DNI, Nombre, Apellido o Email..." 
                         TextChanged="TxtBusqueda_TextChanged" Height="36" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="TxtContador" Grid.Column="1" Text="0 clientes" Foreground="#7F8C8D" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- DATAGRID DE CLIENTES -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="5">
            <DataGrid x:Name="GridClientes" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" x:DataType="vm:ClienteItemViewModel">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DNI" Binding="{Binding DniCliente}" Width="120"/>
                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="220"/>
                    <DataGridTextColumn Header="Correo Electrónico" Binding="{Binding Email}" Width="240"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="140"/>
                    
                    <!-- Estado -->
                    <DataGridTemplateColumn Header="Estado" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ClienteItemViewModel">
                                <Border Background="{Binding EstadoBadgeBackground}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoBadgeForeground}" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones según estado -->
                    <DataGridTemplateColumn Header="Acciones" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ClienteItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Botones para clientes activos -->
                                    <Button Content="✏️ Editar" Click="BtnEditar_Click" 
                                            IsVisible="{Binding EsActivo}"
                                            Background="#F39C12" Foreground="White" 
                                            Padding="10,5" CornerRadius="4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                    
                                    <Button Content="🚫 Baja" Click="BtnBaja_Click" 
                                            IsVisible="{Binding EsActivo}"
                                            Background="#E74C3C" Foreground="White" 
                                            Padding="10,5" CornerRadius="4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                                    <!-- Botón para reactivar clientes dados de baja -->
                                    <Button Click="BtnReactivar_Click" 
                                            IsVisible="{Binding !EsActivo}"
                                            Background="#27AE60" Foreground="White" 
                                            Padding="12,5" CornerRadius="4" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="🔄" FontSize="11"/>
                                            <TextBlock Text="Reactivar Cliente"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- PIE CERRAR -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cerrar" Click="BtnCerrar_Click" 
                    Background="#95A5A6" Foreground="White" 
                    Padding="20,8" CornerRadius="6" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>

    </Grid>
</Window>
