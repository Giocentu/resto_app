<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestoApp.Desktop.ViewModels"
        x:Class="RestoApp.Desktop.Views.GestionClientesWindow"
        Title="RestoApp - Gestión de Clientes"
        Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#F8F9FA">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        
        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Gestión de Clientes" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Búsqueda, modificación y alta de clientes del restaurante" FontSize="12" Foreground="#7F8C8D" Margin="34,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Click="BtnNuevoCliente_Click" 
                    Background="#27AE60" Foreground="White" 
                    Padding="16,9" CornerRadius="6" Cursor="Hand" FontWeight="Bold">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="➕" FontSize="13"/>
                    <TextBlock Text="Nuevo Cliente"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- TOOLBAR BÚSQUEDA -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox x:Name="TxtBusqueda" PlaceholderText="🔍 Buscar por DNI, Nombre, Apellido o Email..." 
                         TextChanged="TxtBusqueda_TextChanged" Height="36" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- DATAGRID DE CLIENTES -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="5">
            <DataGrid x:Name="GridClientes" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" x:DataType="vm:ClienteItemViewModel">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DNI" Binding="{Binding DniCliente}" Width="120"/>
                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="200"/>
                    <DataGridTextColumn Header="Correo Electrónico" Binding="{Binding Email}" Width="220"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="140"/>
                    
                    <DataGridTemplateColumn Header="Acciones" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:ClienteItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="✏️ Editar" Click="BtnEditar_Click" 
                                            Background="#F39C12" Foreground="White" 
                                            Padding="10,5" CornerRadius="4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                    
                                    <Button Content="🚫 Baja" Click="BtnBaja_Click" 
                                            Background="#E74C3C" Foreground="White" 
                                            Padding="10,5" CornerRadius="4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- PIE CERRAR -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cerrar" Click="BtnCerrar_Click" 
                    Background="#95A5A6" Foreground="White" 
                    Padding="20,8" CornerRadius="6" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>

    </Grid>
</Window>
