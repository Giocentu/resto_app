<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestoApp.Desktop.ViewModels"
        x:Class="RestoApp.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RestoApp - Sistema POS Gastronómico Desktop"
        Height="720" Width="1180"
        MinHeight="680" MinWidth="1150"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Estilo base del botón de navegación -->
        <Style Selector="Button.navBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Margin" Value="15,4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo hover del botón -->
        <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Estilo del botón activo/seleccionado -->
        <Style Selector="Button.navBtn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Estilo para el botón de cerrar sesión -->
        <Style Selector="Button.logoutBtn /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#E74C3C"/>
        </Style>
        <Style Selector="Button.logoutBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <!-- GRID EXTERIOR: Divide la pantalla en Barra Lateral (230px) y Área Principal (*) -->
    <Grid ColumnDefinitions="230, *">

        <!-- ========================================== -->
        <!-- COLUMNA 0: BARRA LATERAL -->
        <!-- ========================================== -->
        <Grid Grid.Column="0" Background="#2C3E50" RowDefinitions="*, Auto">

            <!-- Fila 0: Menú de Navegación -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="RestoApp" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,30,0,25"/>

                <Button x:Name="BtnInicio" IsVisible="{Binding PuedeVerPrincipal}" Classes="navBtn active" Content="Inicio" Click="MenuButton_Click" Command="{Binding IrAInicioCommand}"/>
                <Button x:Name="BtnReservas" IsVisible="{Binding PuedeVerReservas}" Classes="navBtn" Content="Reservas" Click="MenuButton_Click" Command="{Binding IrAReservasCommand}"/>
                <Button x:Name="BtnPersonal" IsVisible="{Binding PuedeVerPersonal}" Classes="navBtn" Content="Personal" Click="MenuButton_Click" Command="{Binding IrAEmpleadosCommand}"/>
                <Button x:Name="BtnCaja" IsVisible="{Binding PuedeVerCaja}" Classes="navBtn" Content="Caja" Click="MenuButton_Click" Command="{Binding IrACajaCommand}"/>
                <Button x:Name="BtnEventos" IsVisible="{Binding PuedeVerEventos}" Classes="navBtn" Content="Eventos" Click="MenuButton_Click" Command="{Binding IrAEventosCommand}"/>
                <Button x:Name="BtnClientes" IsVisible="{Binding PuedeVerClientes}" Classes="navBtn" Content="Clientes" Click="MenuButton_Click" Command="{Binding IrAClientesCommand}"/>
            </StackPanel>

            <!-- Fila 1: Área de Usuario y Logout -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="15,20,15,25">
                <!-- Tarjeta visual del Usuario -->
                <Border Background="#34495E" CornerRadius="8" Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Ellipse Width="26" Height="26" Fill="#3498DB"/>
                        <ComboBox SelectedIndex="{Binding IndiceRolSeleccionado}" 
                                  Background="Transparent" Foreground="White" 
                                  BorderThickness="0" Width="120">
                            <ComboBoxItem Content="Dueño"/>
                            <ComboBoxItem Content="Gerente"/>
                            <ComboBoxItem Content="Cajero"/>
                            <ComboBoxItem Content="Recepcion"/>
                            <ComboBoxItem Content="Mozo"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Botón de Cerrar Sesión -->
                <Button Classes="navBtn logoutBtn" Content="Cerrar Sesión" Click="CerrarSesion"/>
            </StackPanel>

        </Grid>

        <!-- ========================================== -->
        <!-- COLUMNA 1: ÁREA CENTRAL DE CONTENIDO DINÁMICO -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Background="#ECF0F1" Padding="20">
            <ContentControl Content="{Binding CurrentView}" 
                            HorizontalContentAlignment="Stretch" 
                            VerticalContentAlignment="Stretch"/>
        </Border>

    </Grid>
</Window>