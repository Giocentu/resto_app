<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RestoApp.Desktop.Views.NuevaUbicacionWindow"
        Title="RestoApp - Registro de Ubicación" 
        Height="380" Width="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#2C3E50">

    <Border Background="White" CornerRadius="12" Margin="20" Padding="25">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- ENCABEZADO MODAL -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="📍" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTituloModal" Text="Nueva Ubicación de Mesa" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Ingrese el nombre del sector o área del restaurante" FontSize="12" Foreground="#7F8C8D" Margin="34,2,0,0"/>
                <Separator Background="#BDC3C7" Margin="0,15,0,0"/>
            </StackPanel>

            <!-- FORMULARIO DE CAMPOS -->
            <StackPanel Grid.Row="1" Spacing="14">
                
                <!-- Campo Nombre de Ubicación -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Nombre / Sector de Ubicación:" Foreground="#34495E" FontWeight="Bold" FontSize="13"/>
                    <TextBox x:Name="TxtNombreUbicacion" PlaceholderText="Ej. Terraza, Salon VIP, Patio Central..." Height="38" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Mensaje de Error / Validación en Rojo -->
                <TextBlock x:Name="TxtError" Foreground="#E74C3C" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- PIE CON BOTONES DE ACCIÓN -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
                <Button Content="Cancelar" Click="BtnCancelar_Click" 
                        Background="#95A5A6" Foreground="White" 
                        Padding="18,10" CornerRadius="6" Cursor="Hand" FontWeight="SemiBold"/>
                
                <Button Content="💾 Guardar Ubicación" Click="BtnGuardar_Click" 
                        Background="#27AE60" Foreground="White" 
                        Padding="20,10" CornerRadius="6" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
