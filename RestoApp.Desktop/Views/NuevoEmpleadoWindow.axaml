<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RestoApp.Desktop.Views.NuevoEmpleadoWindow"
        Title="RestoApp - Registro de Personal" 
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#2C3E50">

    <Border Background="White" CornerRadius="12" Margin="20" Padding="25">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- ENCABEZADO MODAL -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTituloModal" Text="Datos del Empleado" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Complete los datos personales y el rol asignado en el sistema" FontSize="12" Foreground="#7F8C8D" Margin="34,2,0,0"/>
                <Separator Background="#BDC3C7" Margin="0,15,0,0"/>
            </StackPanel>

            <!-- FORMULARIO DE CAMPOS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    
                    <!-- Mensaje de Error / Alerta en Texto Rojo (Al inicio del formulario) -->
                    <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,5" IsVisible="{Binding #TxtError.IsVisible}">
                        <TextBlock x:Name="TxtError" Foreground="#E74C3C" FontSize="12" FontWeight="Bold" IsVisible="False" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Campo DNI -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="DNI / Número de Documento (Obligatorio):" Foreground="#34495E" FontWeight="Bold" FontSize="13"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox x:Name="TxtDni" PlaceholderText="Ingrese DNI (ej. 38450192)..." Height="38" VerticalContentAlignment="Center" TextChanged="TxtDni_TextChanged"/>
                            <Button Grid.Column="1" Content="🔍 Verificar DNI" Click="BtnBuscarDni_Click" Margin="6,0,0,0" Height="38" Background="#3498DB" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>

                    <!-- Campo Nombre Completo -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Nombre y Apellido Completo:" Foreground="#34495E" FontWeight="Bold" FontSize="13"/>
                        <TextBox x:Name="TxtNombre" PlaceholderText="Ej. Carlos Valenzuela..." Height="38" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Campo Cargo / Rol (Sincronizado con BD) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cargo / Rol Asignado:" Foreground="#34495E" FontWeight="Bold" FontSize="13"/>
                        <ComboBox x:Name="CboRol" HorizontalAlignment="Stretch" Height="38" SelectedIndex="3">
                            <ComboBoxItem Content="Dueño"/>
                            <ComboBoxItem Content="Gerente"/>
                            <ComboBoxItem Content="CM"/>
                            <ComboBoxItem Content="Cajero"/>
                            <ComboBoxItem Content="Mozo"/>
                            <ComboBoxItem Content="Cocinero"/>
                            <ComboBoxItem Content="Bachero"/>
                            <ComboBoxItem Content="Bartender"/>
                            <ComboBoxItem Content="Seguridad"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Campo Turno Laboral (Sincronizado con BD) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Turno Laboral Asignado:" Foreground="#34495E" FontWeight="Bold" FontSize="13"/>
                        <ComboBox x:Name="CboTurno" HorizontalAlignment="Stretch" Height="38"/>
                    </StackPanel>

                    <!-- Campo Teléfono -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Teléfono de Contacto:" Foreground="#34495E" FontWeight="Bold" FontSize="13"/>
                        <TextBox x:Name="TxtTelefono" PlaceholderText="Ej. 3795753983" Height="38" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Campo Estado -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Estado Laboral:" Foreground="#34495E" FontWeight="Bold" FontSize="13"/>
                        <ComboBox x:Name="CboEstado" HorizontalAlignment="Stretch" Height="38" SelectedIndex="0">
                            <ComboBoxItem Content="Activo"/>
                            <ComboBoxItem Content="Inactivo"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PIE CON BOTONES DE ACCIÓN -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
                <Button Content="Cancelar" Click="BtnCancelar_Click" 
                        Background="#95A5A6" Foreground="White" 
                        Padding="18,10" CornerRadius="6" Cursor="Hand" FontWeight="SemiBold"/>
                
                <Button Content="💾 Guardar Empleado" Click="BtnGuardar_Click" 
                        Background="#27AE60" Foreground="White" 
                        Padding="20,10" CornerRadius="6" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>


