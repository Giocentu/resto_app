<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RestoApp.Desktop.Views.NuevoEmpleadoWindow"
        Title="Registrar Empleado" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">

    <StackPanel Spacing="15" Margin="20">
        <TextBlock Text="Datos del Empleado" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <TextBox x:Name="TxtDni" PlaceholderText="DNI"/>
        <TextBox x:Name="TxtNombre" PlaceholderText="Nombre Completo"/>
        <TextBox x:Name="TxtRol" PlaceholderText="Cargo / Rol"/>
        <TextBox x:Name="TxtTelefono" PlaceholderText="Teléfono"/>
        <TextBox x:Name="TxtEstado" PlaceholderText="Estado"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click" Background="Transparent"/>
            <Button Content="Guardar" Click="BtnGuardar_Click" Background="#3498DB" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>

