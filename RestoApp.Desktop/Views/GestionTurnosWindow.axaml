<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestoApp.Desktop.ViewModels"
        x:Class="RestoApp.Desktop.Views.GestionTurnosWindow"
        Title="RestoApp - Gestión de Turnos Laborales" 
        Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#2C3E50">

    <Border Background="White" CornerRadius="12" Margin="20" Padding="25">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            
            <!-- ENCABEZADO -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⏰" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Gestión de Turnos Laborales" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Configure los horarios de entrada y salida del personal del restaurante" FontSize="12" Foreground="#7F8C8D" Margin="34,2,0,0"/>
                <Separator Background="#BDC3C7" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- FORMULARIO DE ALTA Y ALERTAS -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,15">
                
                <!-- Mensaje de Error / Alerta en Texto Rojo (Al inicio) -->
                <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="{Binding #TxtError.IsVisible}">
                    <TextBlock x:Name="TxtError" Foreground="#E74C3C" FontSize="12" FontWeight="Bold" IsVisible="False" TextWrapping="Wrap"/>
                </Border>

                <!-- Panel de Nuevo Turno -->
                <Border Background="#F8F9F9" BorderBrush="#E5E7E9" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,15,0">
                            <TextBlock Text="Hora Inicio (HH:mm):" Foreground="#34495E" FontWeight="Bold" FontSize="12"/>
                            <TimePicker x:Name="TpHoraInicio" ClockIdentifier="24HourClock" Height="38" Width="210"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,15,0">
                            <TextBlock Text="Hora Fin (HH:mm):" Foreground="#34495E" FontWeight="Bold" FontSize="12"/>
                            <TimePicker x:Name="TpHoraFin" ClockIdentifier="24HourClock" Height="38" Width="210"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="➕ Crear" Click="BtnCrearTurno_Click"
                                Background="#27AE60" Foreground="White" 
                                Padding="16,0" Height="38" CornerRadius="6" 
                                FontWeight="Bold" Cursor="Hand" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- TABLA DE TURNOS REGISTRADOS -->
            <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8" Padding="10">
                <DataGrid x:Name="DgTurnos" x:DataType="vm:TurnoItemViewModel" 
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                          BorderThickness="1" BorderBrush="#E0E6ED" CornerRadius="6">
                    <DataGrid.Columns>
                        
                        <DataGridTemplateColumn Header="Hora Inicio" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TurnoItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="🛫" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding InicioTexto}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Hora Fin" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TurnoItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="🛬" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FinTexto}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Detalle del Turno" Binding="{Binding Descripcion}" Width="*"/>

                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TurnoItemViewModel">
                                    <Border Background="{Binding EstadoBadgeBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding EstadoBadge}" Foreground="{Binding EstadoBadgeForeground}" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Acción" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TurnoItemViewModel">
                                    <Button Click="BtnToggleEstadoTurno_Click" 
                                            Content="{Binding BotonTexto}"
                                            Background="{Binding BotonBackground}" Foreground="{Binding BotonForeground}" 
                                            BorderBrush="{Binding BotonBorder}" BorderThickness="1" 
                                            CornerRadius="5" Padding="8,4" Margin="4,0" Cursor="Hand" ToolTip.Tip="Cambiar estado del turno"
                                            FontWeight="Bold" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- PIE MODAL -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cerrar" Click="BtnCerrar_Click" 
                        Background="#95A5A6" Foreground="White" 
                        Padding="20,9" CornerRadius="6" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
