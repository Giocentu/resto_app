<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:RestoApp.Desktop.ViewModels"
              xmlns:ent="using:RestoApp.Entities"
              x:Class="RestoApp.Desktop.Views.CajaView"
              x:DataType="vm:CajaViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- ========================================== -->
        <!-- FILA 0: ENCABEZADO Y SELECTOR DE VISTAS   -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,15">
            <!-- Título y Subtítulo del Módulo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="💳 Módulo de Caja, Facturación y Salón" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Cobro de comandas de mesa, desglose de menú y registro de pagos" FontSize="12" Foreground="#7F8C8D"/>
            </StackPanel>

            <!-- Selector de Vistas / Pestañas -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="🍽️ Mesas (Cobros)"
                        Command="{Binding CambiarVistaCommand}" CommandParameter="Cuentas"
                        Classes.activeTab="{Binding EsVistaCuentas}"
                        Classes="tabBtn"/>

                <Button Content="📜 Historial de Pagos"
                        Command="{Binding CambiarVistaCommand}" CommandParameter="Pagos"
                        Classes.activeTab="{Binding EsVistaPagos}"
                        Classes="tabBtn"/>
            </StackPanel>
        </Grid>

        <!-- ========================================== -->
        <!-- FILA 1: ÁREA PRINCIPAL DE CONTENIDO       -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">

            <!-- ========================================== -->
            <!-- VISTA 1: CUENTAS DE MESA Y COMANDAS       -->
            <!-- ========================================== -->
            <Grid IsVisible="{Binding EsVistaCuentas}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="260" MaxWidth="700"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.9*" MinWidth="420"/>
                </Grid.ColumnDefinitions>
                
                <!-- PANEL IZQUIERDO: Listado de Mesas con Cuentas Abiertas -->
                <Border Grid.Column="0" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Padding="15">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Mesas Abiertas" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                <Border Background="#EBF5FB" CornerRadius="12" Padding="8,2">
                                    <TextBlock Text="{Binding CuentasPendientes.Count, StringFormat='{}{0}'}" Foreground="#2980B9" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Click="BtnAbrirMesa_Click"
                                    Background="#27AE60" Foreground="White" 
                                    Padding="10,6" CornerRadius="6" Cursor="Hand" FontWeight="Bold" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="➕" FontSize="11"/>
                                    <TextBlock Text="Abrir Mesa"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- DataGrid de Cuentas Abiertas -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding CuentasPendientes}"
                                  SelectedItem="{Binding CuentaSeleccionada, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="1" BorderBrush="#E0E6ED"
                                  CornerRadius="6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mesa" Binding="{Binding NroMesa}" Width="65"/>
                                <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" Width="100"/>
                                <DataGridTextColumn Header="Mozo" Binding="{Binding AtendidoPor}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding MontoConsumoTexto}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- SEPARADOR DESLIZABLE ENTRE MESAS Y COMANDA -->
                <GridSplitter Grid.Column="1" Width="10" Background="Transparent" 
                              ResizeDirection="Columns" Cursor="SizeWestEast"
                              HorizontalAlignment="Stretch">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" Width="10" HorizontalAlignment="Stretch">
                                <Border Background="#CBD5E1" Width="4" CornerRadius="2" 
                                        VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- PANEL DERECHO: Detalle de Consumos y Cobro de la Mesa Seleccionada -->
                <Border Grid.Column="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Panel>
                        <!-- Caso: Hay Cuenta Seleccionada -->
                        <Grid RowDefinitions="Auto, *, Auto" IsVisible="{Binding TieneCuentaSeleccionada}">
                            
                            <!-- Encabezado de la Mesa -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CuentaSeleccionada.NroMesa, StringFormat='Comanda Mesa #{0}'}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                        <Border Background="#E8F8F5" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding CuentaSeleccionada.Sector}" Foreground="#27AE60" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Selector y Cambio de Mozo a Cargo -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Mozo:" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding MozosDisponibles}"
                                                  SelectedItem="{Binding MozoAsignadoSeleccionado, Mode=TwoWay}"
                                                  DisplayMemberBinding="{Binding NombreCompleto}"
                                                  Height="30" FontSize="12" Padding="8,2"
                                                  CornerRadius="6" VerticalAlignment="Center" Width="180"/>
                                        <Button Content="Cambiar"
                                                Command="{Binding CambiarMozoCuentaCommand}"
                                                Background="#2980B9" Foreground="White"
                                                Padding="10,5" CornerRadius="6" FontSize="11" FontWeight="Bold"
                                                VerticalAlignment="Center" Cursor="Hand"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Botón Cerrar Mesa (Exclusivo Dueño / Gerente para rollback de mesas vacías) -->
                                    <Button Content="Cerrar Mesa"
                                            Command="{Binding CancelarMesaVaciaCommand}"
                                            IsVisible="{Binding EsDuenoOGerente}"
                                            Background="#E74C3C" Foreground="White"
                                            Padding="12,7" CornerRadius="6" Cursor="Hand" FontWeight="Bold" FontSize="12"/>

                                    <Button Click="BtnAgregarProducto_Click"
                                            Background="#2980B9" Foreground="White" 
                                            Padding="12,7" CornerRadius="6" Cursor="Hand" FontWeight="Bold" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="➕" FontSize="11"/>
                                            <TextBlock Text="Agregar Producto"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- DataGrid de Ítems del Menú Consumidos -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,14">
                                <DataGrid ItemsSource="{Binding DetalleItemsCuenta}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"/>
                                        <DataGridTextColumn Header="Descripción del Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="130"/>
                                        <DataGridTextColumn Header="P. Unit." Binding="{Binding PrecioUnitarioTexto}" Width="100"/>
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="110"/>
                                        
                                        <!-- Botón para retirar 1 ítem -->
                                        <DataGridTemplateColumn Header="Quitar" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="ent:CuentaItemDetalleDto">
                                                    <Button Command="{Binding $parent[UserControl].((vm:CajaViewModel)DataContext).QuitarItemDeCuentaCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="#FDEDEC" Foreground="#E74C3C" 
                                                            Padding="6,3" CornerRadius="4" Cursor="Hand" HorizontalAlignment="Center">
                                                        <TextBlock Text="🗑️" FontSize="11"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Panel Inferior: Facturación y Cobro Inmediato -->
                            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16">
                                <Grid ColumnDefinitions="1.2*, 1*, 1.3*" ColumnSpacing="15">
                                    
                                    <!-- Columna 1: Total a Cobrar -->
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL A COBRAR:" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding MontoCobrarTexto}" FontSize="24" FontWeight="Bold" Foreground="#27AE60"/>
                                    </StackPanel>

                                    <!-- Columna 2: Medio de Pago y Vuelto -->
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Medio de Pago:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                        <ComboBox ItemsSource="{Binding MetodosPago}"
                                                  SelectedItem="{Binding MetodoPagoSeleccionado}"
                                                  DisplayMemberBinding="{Binding FormaPago}"
                                                  HorizontalAlignment="Stretch" Height="34"/>

                                        <!-- Cálculo de vuelto si es efectivo -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding EsPagoEfectivo}" Margin="0,4,0,0">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Paga con:" FontSize="10" Foreground="#64748B"/>
                                                <TextBox Text="{Binding MontoRecibido, Mode=TwoWay}" Width="85" Height="28" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Vuelto:" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding VueltoCalculadoTexto}" FontSize="13" FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Columna 3: Botón de Cobro Definitivo -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding ProcesarPagoYLiquidarCommand}"
                                            Background="#27AE60" Foreground="White" 
                                            Height="50" CornerRadius="8" Cursor="Hand" FontWeight="Bold"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <TextBlock Text="Cobrar Mesa" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                        </Grid>

                        <!-- Caso: Sin Cuenta Seleccionada -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding !TieneCuentaSeleccionada}">
                            <TextBlock Text="🍽️" FontSize="42" HorizontalAlignment="Center"/>
                            <TextBlock Text="No hay ninguna mesa seleccionada" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Seleccione una cuenta abierta de la lista de la izquierda para ver su detalle de menú y liquidar el cobro." FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                        </StackPanel>
                    </Panel>
                </Border>

            </Grid>

            <!-- ========================================== -->
            <!-- VISTA 2: HISTORIAL DE PAGOS               -->
            <!-- ========================================== -->
            <Grid IsVisible="{Binding EsVistaPagos}">
                <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Barra Superior del Historial -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,15">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Historial de Cobros Liquidados" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                <Border Background="#EFF6FF" CornerRadius="12" Padding="8,2">
                                    <TextBlock Text="{Binding PagosFiltrados.Count, StringFormat='{}{0} cobros'}" Foreground="#3498DB" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <!-- Filtros de Período y Buscador -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Content="🔄 Actualizar" 
                                        Command="{Binding CargarPagosCommand}"
                                        Background="#F1F5F9" Foreground="#34495E" 
                                        Height="38" Padding="14,0" CornerRadius="6" FontSize="12" FontWeight="SemiBold"
                                        Cursor="Hand" VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Content="Solo Hoy" 
                                            Command="{Binding CambiarFiltroPeriodoCommand}" CommandParameter="Hoy"
                                            Classes.activePeriodo="{Binding EsFiltroHoy}"
                                            Classes="periodoBtn"/>
                                    <Button Content="Todos" 
                                            Command="{Binding CambiarFiltroPeriodoCommand}" CommandParameter="Todos"
                                            Classes.activePeriodo="{Binding EsFiltroTodos}"
                                            Classes="periodoBtn"/>
                                </StackPanel>

                                <TextBox Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                         PlaceholderText="🔍 Buscar por mesa, comanda o mozo..." 
                                         Width="260" Height="38"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid de Historial de Pagos (SIN COLUMNA #) -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding PagosFiltrados}"
                                  SelectedItem="{Binding PagoSeleccionado}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="1" BorderBrush="#E0E6ED"
                                  CornerRadius="6">
                            <DataGrid.Columns>
                                <!-- SIN LA COLUMNA # SEGÚN SOLICITUD -->
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="95"/>
                                <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="85"/>
                                <DataGridTextColumn Header="Descripción / Mesa" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="Cliente / Detalle" Binding="{Binding ClienteNombre}" Width="200"/>
                                
                                <!-- Columna Medio de Pago con Badge Coloreado -->
                                <DataGridTemplateColumn Header="Medio de Pago" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:PagoItemViewModel">
                                            <Border Background="{Binding MedioPagoBadgeBackground}" 
                                                    CornerRadius="12" Padding="10,4" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MedioPago}" 
                                                           Foreground="{Binding MedioPagoBadgeForeground}" 
                                                           FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Monto Total" Binding="{Binding MontoTexto}" Width="140"/>

                                <!-- Acciones: Ver Ticket / Eliminar -->
                                <DataGridTemplateColumn Header="Acciones" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:PagoItemViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="📜 Ticket" 
                                                        Command="{Binding $parent[UserControl].((vm:CajaViewModel)DataContext).VerComprobanteCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#34495E" Foreground="White" 
                                                        FontSize="11" FontWeight="SemiBold" CornerRadius="4" Padding="8,4" Cursor="Hand"/>
                                                
                                                <Button Content="🗑️" 
                                                        Command="{Binding $parent[UserControl].((vm:CajaViewModel)DataContext).EliminarPagoCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#FEE2E2" Foreground="#E74C3C" 
                                                        FontSize="12" CornerRadius="4" Padding="6,4" Cursor="Hand"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        </Grid> <!-- FIN Grid.Row=1 -->



        <!-- ========================================== -->
        <!-- MODAL 3: TICKET DIGITAL DETALLADO          -->
        <!-- ========================================== -->
        <Grid Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding MostrarModalComprobante}">
            <Border Background="White" CornerRadius="12" Padding="24" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="📜 Ticket de Comprobante Fiscal / Comercial" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <TextBlock Text="RestoApp - Sistema Gastronómico POS" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>

                    <Separator Background="#CBD5E1"/>

                    <!-- Cabecera del Ticket -->
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Comprobante:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ComprobantePago.Descripcion}" FontWeight="Bold" Foreground="#2C3E50"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha y Hora:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ComprobantePago.FechaPago, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="#2C3E50"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Medio de Pago:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ComprobantePago.MedioPago}" FontWeight="Bold" Foreground="#2980B9"/>
                    </Grid>

                    <Separator Background="#CBD5E1"/>

                    <!-- Detalle de Productos Consumidos -->
                    <TextBlock Text="Detalle de Consumos:" FontSize="13" FontWeight="Bold" Foreground="#34495E"/>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" MaxHeight="180">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ItemsComprobante}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="ent:CuentaItemDetalleDto">
                                        <Grid ColumnDefinitions="30, *, Auto" Margin="10,4">
                                             <TextBlock Grid.Column="0" Text="{Binding Cantidad, StringFormat='{}{0}x'}" FontWeight="Bold" Foreground="#2C3E50"/>
                                             <TextBlock Grid.Column="1" Text="{Binding NombreProducto}" Foreground="#2C3E50"/>
                                             <TextBlock Grid.Column="2" Text="{Binding SubtotalTexto}" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Separator Background="#CBD5E1"/>

                    <!-- Total Facturado -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <TextBlock Grid.Column="0" Text="TOTAL FACTURADO:" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ComprobantePago.MontoTexto}" FontSize="22" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="Cerrar" 
                            Command="{Binding CerrarModalComprobanteCommand}" 
                            Background="#2C3E50" Foreground="White" 
                            Height="42" CornerRadius="6" FontWeight="Bold" HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            Cursor="Hand" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

    <UserControl.Styles>
        <!-- Estilo Base del Botón de Pestaña -->
        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <!-- Pestaña Activa -->
        <Style Selector="Button.tabBtn.activeTab">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.tabBtn.activeTab /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Filtros de Período Historial -->
        <Style Selector="Button.periodoBtn">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.periodoBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style Selector="Button.periodoBtn.activePeriodo">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2980B9"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.periodoBtn.activePeriodo /template/ ContentPresenter">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
</UserControl>
