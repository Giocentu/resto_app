<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestoApp.Desktop.ViewModels"
             x:Class="RestoApp.Desktop.Views.MesasView"
             x:DataType="vm:MesasViewModel">

    <Grid RowDefinitions="Auto, *" Margin="10">
        <!-- Encabezado: Título y Botón -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" Text="Listado de Mesas" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Nueva Mesa" IsVisible="{Binding $parent[UserControl].((vm:MesasViewModel)DataContext).PuedeAgregar}" Background="#27AE60" Foreground="White" Padding="15,8" CornerRadius="5" Cursor="Hand" Click="BtnNuevaMesa_Click"/>
        </Grid>

        <!-- Tabla de Datos -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Mesas}" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  GridLinesVisibility="All" BorderBrush="LightGray" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nro Mesa" Binding="{Binding NroMesa}" Width="*"/>
                <DataGridTextColumn Header="Capacidad" Binding="{Binding Capacidad}" Width="*"/>
                <DataGridTextColumn Header="Ubicación" Binding="{Binding UbicacionDescripcion}" Width="2*"/>

                <!-- Columna de Edición -->
                <DataGridTemplateColumn Header="Editar" Width="Auto"
                                        IsVisible="{Binding $parent[UserControl].((vm:MesasViewModel)DataContext).PuedeEditar}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MesaItemViewModel">
                            <Button Content="Editar" 
                                    Click="BtnEditar_Click" 
                                    Background="Transparent" 
                                    Foreground="#F39C12" 
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            
                <!-- Columna de Baja Lógica -->
                <DataGridTemplateColumn Header="Baja" Width="Auto"
                                        IsVisible="{Binding $parent[UserControl].((vm:MesasViewModel)DataContext).PuedeEditar}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MesaItemViewModel">
                            <Button Content="Eliminar" 
                                    Click="BtnEliminar_Click" 
                                    Background="Transparent" 
                                    Foreground="#E74C3C" 
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>