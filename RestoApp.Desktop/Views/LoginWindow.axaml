<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestoApp.Desktop.ViewModels"
        x:Class="RestoApp.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="RestoApp - Iniciar Sesión" Height="490" Width="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#1E293B"
        KeyDown="OnWindowKeyDown">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <Border Background="White" CornerRadius="12" Padding="30,28" Width="340"
                BoxShadow="0 10 25 0 #40000000">
            <StackPanel Spacing="18">
                
                <!-- Encabezado con icono y títulos -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <Border Background="#3498DB" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="🍽️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RestoApp" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistema de Gestión Gastronómica" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>

                <Separator Background="#E2E8F0" Margin="0,2"/>

                <!-- Campo Usuario -->
                <StackPanel Spacing="6">
                    <TextBlock Text="DNI" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBox Text="{Binding NombreUsuario}" 
                             PlaceholderText="Ingrese su DNI sin espacios y sin puntos" 
                             FontSize="14" Padding="12,10" 
                             CornerRadius="6"/>
                </StackPanel>
                
                <!-- Campo Contraseña -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Contraseña" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBox Text="{Binding Password}" 
                             PlaceholderText="Ingrese su contraseña" 
                             PasswordChar="•" 
                             FontSize="14" Padding="12,10" 
                             CornerRadius="6"/>
                </StackPanel>

                <!-- Mensaje de Alerta / Error -->
                <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" 
                        CornerRadius="6" Padding="10,8"
                        IsVisible="{Binding TieneError}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MensajeError}" 
                                   Foreground="#C0392B" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   MaxWidth="240"/>
                    </StackPanel>
                </Border>

                <!-- Botón de Ingreso -->
                <Button x:Name="BtnIngresar"
                        Click="BtnIngresar_Click"
                        IsEnabled="{Binding !EstaCargando}"
                        Background="#3498DB" Foreground="White" 
                        FontSize="15" FontWeight="Bold" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                        Padding="12" CornerRadius="6" Cursor="Hand">
                    <Panel>
                        <TextBlock Text="Ingresar" IsVisible="{Binding !EstaCargando}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Verificando..." IsVisible="{Binding EstaCargando}" HorizontalAlignment="Center"/>
                    </Panel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
