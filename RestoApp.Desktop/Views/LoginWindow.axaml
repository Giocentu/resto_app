<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestoApp.Desktop.ViewModels"
        x:Class="RestoApp.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="RestoApp - Login" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#2C3E50">

    <Border Background="White" CornerRadius="10" Margin="40" Padding="30">
        <StackPanel Spacing="20" VerticalAlignment="Center">
            
            <TextBlock Text="Iniciar Sesión" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>

            <TextBox Text="{Binding NombreUsuario}" PlaceholderText="Usuario" FontSize="16" Padding="10"/>
            
            <TextBox Text="{Binding Password}" PlaceholderText="Contraseña" PasswordChar="*" FontSize="16" Padding="10"/>

            <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" HorizontalAlignment="Center" FontWeight="SemiBold"/>

            <Button Content="Ingresar" 
                    Click="BtnIngresar_Click"
                    Background="#3498DB" Foreground="White" 
                    FontSize="16" FontWeight="Bold" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                    Padding="10" CornerRadius="5" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>